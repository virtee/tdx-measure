# The root .gitignore excludes *.bin and *.json globally; un-ignore the
# per-fixture inputs so they get checked in.
!*/metadata.json
!*/acpi_tables.bin
!*/expected.json

# OVMF.fd is large and reproducible; let tests/fetch_ovmf.sh download it.
OVMF.fd

# upstream-edk2-<version> fixtures build their own OVMF binaries and version markers via tests/fetch_ovmf.sh.
upstream-edk2-*/*.fd
upstream-edk2-*/.edk2-version
